# ─────────────────────────────────────────────────────────────
# Rainmaker: environment variables
# Copy to .env.local and fill in what you have. Everything is optional:
# without keys the app runs in demo mode on free OpenStreetMap data.
# ─────────────────────────────────────────────────────────────

# ── Claude (the brain) ───────────────────────────────────────
# Turns on AI ad campaigns, AI outreach, web research and the agents.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Model for every Claude call. Default: claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# How agents run:
#   managed  = Claude Managed Agents (default). Anthropic hosts the agent loop;
#              your server answers the CRM tool calls. Beta; billed for session
#              runtime on top of tokens; sessions are kept in the Claude Console
#              until you delete them.
#   messages = the plain Messages API, with the agent loop on your server.
AGENT_RUNTIME=managed

# Hard spending cap per agent run, in US dollars (Managed Agents only).
AGENT_RUN_BUDGET_USD=3

# ── Finding clients ──────────────────────────────────────────
# Google Places API (New) key. Adds ratings, review counts and better coverage.
# Without it, search uses OpenStreetMap (free, no key).
GOOGLE_PLACES_API_KEY=

# Nominatim + Overpass endpoints (OpenStreetMap). The public servers are fine
# for light use; point these at your own or a paid host for heavy use.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Business search uses Nominatim. To use Overpass instead (complete map data,
# no 40-per-query cap), point this at a server you run or pay for; several,
# comma-separated, are tried in order. The free public Overpass servers turn
# away requests from cloud hosts such as Vercel.
# OVERPASS_URL=https://overpass.example.com/api/interpreter

# ── Sending email ────────────────────────────────────────────
# Approved outreach is sent through Resend when this is set. Without it,
# "Send" opens your own mail app with the message filled in.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Sam at Acme <sam@acme.co>"
RESEND_FROM=

# ── ElevenLabs (voice agents, voiceovers, ad art) ────────────
# Turns on the store's AI sales assistant (voice and chat), the demo AI
# receptionists Autopilot builds for prospects, ad voiceovers and custom ad
# art. Create a key in ElevenLabs under Developers > API keys. If you restrict
# it, allow Agents (write), Text to Speech, Voices (read) and Image & Video.
# The key stays on the server; browsers only get one-conversation tokens.
ELEVENLABS_API_KEY=

# The store's sales assistant. Defaults to the agent already built and tested
# in this agency's ElevenLabs workspace (agent_2301m80gw6zvekktsm8d0sr9gwe3),
# which only works with that workspace's key. With a key from another
# workspace, press "Sync sales assistant" in Store & pricing to create one.
# ELEVENLABS_SALES_AGENT_ID=

# The CRM copilot (voice and chat agent that runs the app). Defaults to the
# one built in this agency's workspace (agent_6701m80nkwe4ekh9nkkcjbtj81ns);
# with another workspace's key, press Sync copilot in Settings.
# ELEVENLABS_COPILOT_AGENT_ID=

# Optional overrides (defaults shown).
# ELEVENLABS_AGENT_LLM=claude-sonnet-5-5           # LLM inside the voice agents
# ELEVENLABS_AGENT_TTS_MODEL=eleven_v4_turbo       # falls back to eleven_flash_v2_5
# ELEVENLABS_AGENT_VOICE_ID=F89WkXaQbUlVyNvtlD3X   # receptionist and sales voice; with another
#                                                  # workspace, use a voice from its library
# ELEVENLABS_VOICEOVER_VOICE_ID=cjVigY5qzO86Huf0OWal
# ELEVENLABS_TTS_MODEL=eleven_v4                   # ad voiceovers
# ELEVENLABS_IMAGE_MODEL=gpt-image-2               # ad art (Image & Video API, Pro plan and up)
# DEMO_SESSIONS_PER_DAY=12                         # conversations per demo link per day
# ART_ON_ORDERS=0                                  # don't make ad art when an order is paid

# ── Getting paid: Stripe ─────────────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_... while you
# test: the store shows a test-mode banner and no real money moves). Prices
# don't need to exist in Stripe: each checkout carries its own price.
STRIPE_SECRET_KEY=
# Leave empty and press "Connect webhooks" in Store & pricing once the app is
# deployed: it creates the endpoint and keeps the signing secret. Set it only
# if you made the endpoint yourself (https://YOUR-SITE/api/payments/stripe/webhook,
# events: checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, invoice.payment_failed, customer.subscription.updated,
# customer.subscription.deleted).
STRIPE_WEBHOOK_SECRET=
# Set to 1 to have Stripe Tax add sales tax/VAT (turn Stripe Tax on first).
# STRIPE_AUTOMATIC_TAX=1

# ── Getting paid: PayPal ─────────────────────────────────────
# A REST app from https://developer.paypal.com/dashboard/applications
# (Sandbox while you test). Subscriptions must be enabled on the account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_MODE=sandbox
# Like Stripe: "Connect webhooks" registers https://YOUR-SITE/api/payments/paypal/webhook
# and stores the id. Set it only if you registered the webhook yourself.
PAYPAL_WEBHOOK_ID=

# ── Your public address ──────────────────────────────────────
# Used for checkout return links, webhook addresses and the demo links in
# Autopilot's emails, e.g. https://ai.youragency.com. On Vercel the
# production domain is used when this is empty.
SITE_URL=

# ── Autopilot schedule ───────────────────────────────────────
# Any long random string. Vercel Cron sends it when it calls
# /api/cron/autopilot once a day (see vercel.json); without it Autopilot only
# runs when you press "Run now".
CRON_SECRET=

# ── Sign-in ──────────────────────────────────────────────────
# Required for any deployment on the internet. Visitors must enter this
# password; a phone stays signed in for 6 months.
APP_PASSWORD=

# ── Storage ──────────────────────────────────────────────────
# Postgres connection string. Use it on any cloud host, and always on Vercel
# (its servers don't keep files). Vercel's Neon integration sets this for you.
# Without it, data goes to a JSON file in DATA_DIR (default ./.data).
DATABASE_URL=
DATA_DIR=
