{
  "name": "neon-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial voice-guided interactive map, secrets, tips and daily news for GTA VI.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "intel:update": "node scripts/update-intel.mjs",
    "intel:test": "node --test scripts/test/*.test.mjs",
    "geo:build": "node scripts/build-geodata.mjs",
    "vendor:copy": "node scripts/copy-vendor.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs",
    "test": "node --test scripts/test/*.test.mjs",
    "sites:build": "node microsites/build.mjs",
    "sites:test": "node --test microsites/test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@elevenlabs/react": "1.23.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.39.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@turf/turf": "7.4.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-xml-parser": "5.12.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
