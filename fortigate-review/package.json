{
  "name": "fortigate-review",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude Managed Agent that reviews a FortiGate rulebase and firmware from a config backup and drafts fixes for an engineer to approve.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "review": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/review.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
