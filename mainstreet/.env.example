# Mainstreet configuration. Copy to .env (npm run setup does it) and fill in
# what you have. Everything is optional: with no keys it runs in demo mode on
# fictional businesses and never sends anything.

# ── The crew's brains and eyes ───────────────────────────────────────────
# Claude writes the diagnoses, site content, video scripts, pitches and replies.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Google Places API (New): real businesses, ratings, hours and reviews.
# Without it the Scout uses fictional demo businesses.
GOOGLE_PLACES_API_KEY=

# ── ElevenLabs: voiceovers, hero images and Atlas (the voice agent) ──────
ELEVENLABS_API_KEY=
# Atlas is already built in your workspace (agent_0201m8frayw7fm68dbetfva0yz1n) and
# used by default. Set this only to pin a different agent:
ELEVENLABS_AGENT_ID=
# The Filmer's narrator (premade "Eric") and Atlas's voice ("Jake") for new agents:
# ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
# ELEVENLABS_AGENT_VOICE_ID=CDdUdrzh7qrDE2xpRZyQ
# Atlas's LLM inside ElevenLabs (fast enough for live voice):
# ELEVENLABS_AGENT_LLM=claude-sonnet-5-5
# Hero image model (Image & Video API, Pro plan and up):
# ELEVENLABS_IMAGE_MODEL=gpt-image-2
# An imported phone number Atlas can call you from for escalations
# (ElevenLabs → Phone Numbers). Also turn on "call me" in Settings.
ELEVENLABS_PHONE_NUMBER_ID=

# ── Sending and getting paid ─────────────────────────────────────────────
# Resend for email, from a domain you've verified there.
RESEND_API_KEY=
MAIL_FROM="Your Name at Your Studio <you@yourstudio.com>"
# Replies: point a Resend inbound address (or any service that can POST
# JSON) at https://YOUR-SITE/webhooks/inbound-email?secret=INBOUND_SECRET.
# With REPLY_TO set, pitches use reply+<token>@ so every reply matches its lead.
REPLY_TO=
INBOUND_SECRET=

# Stripe Checkout for "Claim this website". Add a webhook in Stripe for
# checkout.session.completed → https://YOUR-SITE/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── You ──────────────────────────────────────────────────────────────────
# (All editable later in Settings.) Your postal address goes on every email:
# CAN-SPAM and Canada's CASL require it, so nothing sends without it.
OWNER_NAME=
AGENCY_NAME="Mainstreet Studio"
OWNER_EMAIL=
OWNER_PHONE=
POSTAL_ADDRESS=
BOOKING_URL=
# TZ=America/Toronto

# Push notifications to your phone with the free ntfy app (pick a long,
# unguessable topic name and subscribe to it in the app).
NTFY_TOPIC=

# ── Hosting ──────────────────────────────────────────────────────────────
# Your public https address. Proposal links, webhooks and calling Atlas by
# phone need it (a Cloudflare Tunnel to your computer works too).
PUBLIC_URL=
# Required as soon as the app is reachable from the internet:
APP_PASSWORD=
PORT=8787
# HOST=0.0.0.0           # listen on all interfaces (Docker, a server)
# DATA_DIR=./data
# DEMO=1                 # force demo mode even with keys

# ── Atlas on the phone and Mainstreet over MCP ──────────────────────────
# Numbers allowed to give Atlas orders on a call (E.164, comma separated):
OWNER_PHONES=
# PIN Atlas asks for on calls before anything that sends, spends or approves:
OWNER_VOICE_PIN=
# Key ElevenLabs sends with Atlas's webhook tools (generated if empty):
VOICE_TOOL_SECRET=
# Turns on /mcp so Claude (Code, Desktop, claude.ai) can run the business:
MCP_TOKEN=

# ── Optional cost overrides used by the Checker's estimates (USD) ────────
# PRICE_GOOGLE_SEARCH=0.035
# PRICE_GOOGLE_DETAILS=0.025
# PRICE_ELEVEN_CHAR=0.0002
# PRICE_ELEVEN_IMAGE=0.06
