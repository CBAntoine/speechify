{
  "name": "shuttle",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first screen recorder: screen + camera, live captions, text-based editing, zooms and silence removal, all in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "e2e": "node tests/e2e/run.mjs && node tests/e2e/phone.mjs",
    "build:android": "vite build --mode android && cap sync android",
    "apk": "npm run build:android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "mediabunny": "1.65.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
