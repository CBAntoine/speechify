<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_record"
        android:shortcutId="record"
        android:shortcutLongLabel="@string/shortcut_record_long"
        android:shortcutShortLabel="@string/shortcut_record_short">
        <intent
            android:action="com.cbantoine.dashcam.action.START_RECORDING"
            android:targetClass="com.cbantoine.dashcam.MainActivity"
            android:targetPackage="com.cbantoine.dashcam" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_clips"
        android:shortcutId="clips"
        android:shortcutLongLabel="@string/shortcut_clips_long"
        android:shortcutShortLabel="@string/shortcut_clips_short">
        <intent
            android:action="com.cbantoine.dashcam.action.OPEN_CLIPS"
            android:targetClass="com.cbantoine.dashcam.MainActivity"
            android:targetPackage="com.cbantoine.dashcam" />
    </shortcut>
</shortcuts>
