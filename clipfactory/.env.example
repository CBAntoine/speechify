# Clip Factory: every setting is optional. Copy to .env.local.

# Claude picks the moments, writes hooks and titles, and translates dubs.
# Without it, a built-in loudness + hype-word scorer picks the moments.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# WhisperX speaker labels ("who's talking"). Accept the pyannote model terms on Hugging Face first.
HF_TOKEN=

# Whisper model size (default: base on CPU, large-v3 on an NVIDIA GPU).
# CF_WHISPER_MODEL=small

# Fine-tuned F5-TTS checkpoints for dubbing into languages the base model doesn't speak.
# CF_F5_CKPT_ES=/path/to/model.safetensors
# CF_F5_VOCAB_ES=/path/to/vocab.txt

# SAM 2 checkpoint/config, if not in models/sam2 (npm run setup -- --sam2).
# CF_SAM2_CHECKPOINT=
# CF_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml

# How many jobs run at once (each one already uses every CPU core).
# CF_MAX_JOBS=1

# Where jobs are stored (default ./workspace) and which Python runs the helpers.
# CF_WORKSPACE=
# CF_PYTHON=

# Raises GitHub's rate limit for the star counts in the header.
# CF_GITHUB_TOKEN=
