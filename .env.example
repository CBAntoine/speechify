# ─────────────────────────────────────────────────────────────
# GTA 6 Secrets Map — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel.
# Every monetization feature is inert until its keys are set.
# ─────────────────────────────────────────────────────────────

# On Vercel, only ELEVENLABS_API_KEY is required: the rest has working defaults.

# Public site URL (used for SEO, sitemap, Stripe redirects). On Vercel this
# defaults to the project's production domain; set it once you add your own.
NEXT_PUBLIC_SITE_URL=

# Long random string used to sign quota + Crew Pass cookies. Recommended.
# If unset, one is derived from ELEVENLABS_API_KEY (rotating that key then resets cookies).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Search engines ───────────────────────────────────────────
# Codes from Google Search Console / Bing Webmaster Tools ("HTML tag" method),
# so you can verify the site and submit /sitemap.xml.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# (GitHub repository variable, not Vercel) SITE_URL=https://your-domain
# tells the daily job where to send IndexNow pings once you have a domain.

# ── Voice guide (ElevenLabs Agents) ──────────────────────────
# Agent ID of the "Sol" voice guide (already created for you; this is the default).
ELEVENLABS_AGENT_ID=agent_7001m7t6yy2fekkta6jf0fnq0t14
# Server-side API key. When set, the site issues short-lived conversation
# tokens and your agent can stay private (recommended for production).
ELEVENLABS_API_KEY=
# Free and Crew Pass daily voice-session allowances.
VOICE_FREE_SESSIONS_PER_DAY=3
VOICE_CREW_SESSIONS_PER_DAY=60
# Typed-chat sessions with Sol (much cheaper than voice).
TEXT_FREE_SESSIONS_PER_DAY=15
TEXT_CREW_SESSIONS_PER_DAY=300

# ── Map: street detail, place search, routing ────────────────
# Street-level vector tiles (OpenMapTiles schema TileJSON). Default is
# OpenFreeMap (free, no key). Set "off" to show only the state-level chart.
NEXT_PUBLIC_STREET_TILES_URL=
# Place search (Nominatim API). The public OpenStreetMap server allows ~1
# request/second; for real traffic use your own Nominatim or a host such as
# LocationIQ (then also set GEOCODER_KEY).
GEOCODER_URL=
GEOCODER_KEY=
# Street routing (any OSRM-compatible server). Defaults are the FOSSGIS public
# servers, meant for light use; point these at your own OSRM for heavy traffic.
ROUTING_URL_DRIVING=
ROUTING_URL_WALKING=
ROUTING_URL_CYCLING=

# ── Ads (Google AdSense) ─────────────────────────────────────
# e.g. ca-pub-1234567890123456. Leave empty to show house ads instead.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional ad unit slot IDs
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ── Affiliate (Amazon Associates) ────────────────────────────
# Your tracking tag, e.g. gta6secrets-20
NEXT_PUBLIC_AMAZON_TAG=

# ── Crew Pass membership (Stripe) ────────────────────────────
# Stripe Payment Link for the membership. In the link's settings, set
# "After payment" → redirect to:
#   https://YOUR-DOMAIN/crew-pass/success?session_id={CHECKOUT_SESSION_ID}
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# Optional: Stripe customer-portal login link (lets members manage billing)
NEXT_PUBLIC_STRIPE_PORTAL_URL=
# Secret key used server-side to verify checkouts (sk_live_… / sk_test_…)
STRIPE_SECRET_KEY=
# Displayed price
NEXT_PUBLIC_CREW_PASS_PRICE=$4.99/mo
# How many browsers one membership can be restored on
CREW_PASS_MAX_DEVICES=5

# ── Newsletter (Resend) ──────────────────────────────────────
RESEND_API_KEY=
# Resend segment (audience) ID that new subscribers are added to
RESEND_SEGMENT_ID=
# Sender for Crew Pass restore emails, on a domain you verified in Resend
RESEND_FROM=GTA 6 Secrets Map <hello@your-domain.com>

# ── Community submissions ────────────────────────────────────
# Fine-grained GitHub token with "Issues: read & write" on the content repo.
# Submissions become issues; add the "approved" label to publish them.
GITHUB_SUBMISSIONS_TOKEN=
GITHUB_SUBMISSIONS_REPO=CBAntoine/speechify

# ── Daily intel (GitHub Actions secrets, not Vercel) ─────────
# ANTHROPIC_API_KEY  → enables the AI-written daily brief (optional)
