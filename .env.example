# ─────────────────────────────────────────────────────────────
# Neon Atlas — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel.
# Every monetization feature is inert until its keys are set.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO, sitemap, Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://example.com

# Long random string used to sign quota + Crew Pass cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Voice guide (ElevenLabs Agents) ──────────────────────────
# Agent ID of the "Sol" voice guide.
ELEVENLABS_AGENT_ID=
# Server-side API key. When set, the site issues short-lived conversation
# tokens and your agent can stay private (recommended for production).
ELEVENLABS_API_KEY=
# Free and Crew Pass daily voice-session allowances.
VOICE_FREE_SESSIONS_PER_DAY=3
VOICE_CREW_SESSIONS_PER_DAY=60

# ── Ads (Google AdSense) ─────────────────────────────────────
# e.g. ca-pub-1234567890123456. Leave empty to show house ads instead.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional ad unit slot IDs
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ── Affiliate (Amazon Associates) ────────────────────────────
# Your tracking tag, e.g. neonatlas-20
NEXT_PUBLIC_AMAZON_TAG=

# ── Crew Pass membership (Stripe) ────────────────────────────
# Stripe Payment Link for the membership. In the link's settings, set
# "After payment" → redirect to:
#   https://YOUR-DOMAIN/crew-pass/success?session_id={CHECKOUT_SESSION_ID}
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# Optional: Stripe customer-portal login link (lets members manage billing)
NEXT_PUBLIC_STRIPE_PORTAL_URL=
# Secret key used server-side to verify checkouts (sk_live_… / sk_test_…)
STRIPE_SECRET_KEY=
# Displayed price
NEXT_PUBLIC_CREW_PASS_PRICE=$4.99/mo

# ── Newsletter (Resend) ──────────────────────────────────────
RESEND_API_KEY=
# Resend segment (audience) ID that new subscribers are added to
RESEND_SEGMENT_ID=

# ── Community submissions ────────────────────────────────────
# Fine-grained GitHub token with "Issues: read & write" on the content repo.
# Submissions become issues; add the "approved" label to publish them.
GITHUB_SUBMISSIONS_TOKEN=
GITHUB_SUBMISSIONS_REPO=CBAntoine/speechify

# ── Daily intel (GitHub Actions secrets, not Vercel) ─────────
# ANTHROPIC_API_KEY  → enables the AI-written daily brief (optional)
